# signing.env — copy to signing.env (gitignored) and fill in your Apple Developer Team ID.
# Sourced by remote-build.sh, serve-ipa.sh and tools/ci/build-release-artifacts.sh; project.yml reads
# DEVELOPMENT_TEAM from the environment for automatic signing.

# Your 10-character Team ID: developer.apple.com -> Account -> Membership details, or Xcode ->
# Settings -> Accounts.
export DEVELOPMENT_TEAM=
